<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 1.9//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="refinery" timelimit="30 min" hardtimelimit="30 min" memlimit="30 GB" cpuCores="8">

    <!-- Only the finite-model search (tree automata over the datatypes), whose sat answers come with a
         model. It refuses sorts other than datatypes and Booleans, so it enters ADT-LIA only. -->
    <option>--prove-sat</option>

<rundefinition name="CHC-COMP2026_check-sat">
  <tasks name="ADT-LIA">
    <includesfile>../chc-comp26-benchmarks/ADT-LIA.set</includesfile>
    <propertyfile expectedverdict="true">../chc-comp26-benchmarks/properties/check-sat.prp</propertyfile>
  </tasks>
</rundefinition>

</benchmark>
