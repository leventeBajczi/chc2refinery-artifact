#!/usr/bin/env python3
"""Decide a CHC-COMP benchmark with chc2refinery and the Refinery graph solver.

chc2refinery.py (https://github.com/leventeBajczi/chc2refinery) runs two searches in parallel,
each with a Refinery process of its own, and the first verdict stops the other:

  --prove-unsat  a derivation of false (unsat); sat if Refinery exhausts the derivations and
                 the encoding is exact;
  --prove-sat    a finite model over the algebraic datatypes (sat); other problems are refused.

The first line of the output is the verdict (sat, unsat or unknown), followed by the witness.
Options (e.g., --prove-unsat to run one mode only) are passed on to chc2refinery.py.

With --unsat-alethe, the unsat answer is followed by an Alethe proof instead of the derivation (Z3's
Python API, in python/, re-solves the derivation for exact values).

This script, chc2refinery.py with its modules, the Refinery CLI (refinery-generator-cli/), a JDK
(jdk/) and Z3's Python API (python/) are installed side by side by `make tools/refinery`.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
CLI = os.path.join(HERE, 'refinery-generator-cli', 'bin', 'refinery-generator-cli')
JDK = os.path.join(HERE, 'jdk')


def version() -> str:
    with open(os.path.join(HERE, 'VERSION')) as f:
        return f.readline().strip()


def main(argv: list[str]) -> int:
    if argv == ['--version']:
        print(version())
        return 0
    # Two Refinery JVMs run in parallel, so each gets at most 40% of the memory. chc2refinery.py
    # raises the Z3 limits (Z3 must not give up before the run does) and gives every run its own
    # temporary directory, into which Z3 and OR-Tools unpack their native libraries.
    env = dict(os.environ, JAVA_HOME=JDK)
    env['PYTHONPATH'] = os.pathsep.join(p for p in (os.path.join(HERE, 'python'), env.get('PYTHONPATH')) if p)
    env['JAVA_OPTS'] = f"{env.get('JAVA_OPTS', '')} -XX:MaxRAMPercentage=40".strip()
    command = [sys.executable, os.path.join(HERE, 'chc2refinery.py'), *argv, '--refinery', CLI]
    os.execve(sys.executable, command, env)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
